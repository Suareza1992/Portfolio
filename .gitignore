# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# package-lock.json IS committed: it pins the Tailwind version used to build
# assets/tailwind.css, so the CSS is reproducible.

# Environment variables
.env

# Build output
dist/
build/

# System files
.DS_Store
Thumbs.db

# Logs
logs
*.log

# IDE/editor configs
.vscode/
.idea/

# Local dev config: launch.json holds a machine-specific absolute path
.claude/
*.sublime-workspace
*.sublime-project

# Optional: exclude Mac system files and backups
*.swp
*.bak
*.tmp

# Build inputs are committed; assets/tailwind.css is generated by
# `npm run build:css` and committed too, so the site stays deploy-by-copy.
